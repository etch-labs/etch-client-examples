# Keep your package token and API key somewhere safe (your keyring, ~/.netrc, or a
# CI secret). For simplicity, this example reads them from .env: copy this file to
# .env and fill in both values from your ETCH dashboard. .env is in .gitignore, so
# they stay out of git.

# Package token (Integrations page, JavaScript): lets npm download the ETCH JavaScript client
ETCH_TOKEN=your-package-token

# API key (API keys page): the etch command uses it to call ETCH
ETCH_API_KEY=your-api-key
